; Engine configuration file.
; LowerTale — an Undertale-inspired RPG made with Godot 4.
config_version=5

[application]

config/name="LowerTale"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

GameState="*res://scripts/game_state.gd"
DialogueDB="*res://scripts/dialogue_db.gd"
DataLoader="*res://scripts/data_loader.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas"
window/stretch/aspect="keep"

