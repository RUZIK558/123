extends Node
## DialogueDB — база реплик и внутриигровых текстов (локализации нет, всё на русском).

var lines: Dictionary = {}

func _ready() -> void:
	_build()

func get_line(key: String) -> String:
	return lines.get(key, "")

func _add(k: String, v: String) -> void:
	lines[k] = v

func _build() -> void:
	# --- Титул / интро ---
	_add("title_tagline", "Долгая история короткой жизни")
	_add("intro_1", "Давным-давно два народа населяли Поверхность:")
	_add("intro_2", "люди и монстры. Однажды война опустошила землю.")
	_add("intro_3", "Победители воздвгли Печать — барьер из семи магических артефактов,")
	_add("intro_4", "и заточили проигравших глубоко под землёй.")
	_add("intro_5", "Много веков спустя гора Эхо-Пик стала запретной...")
	_add("intro_6", "Говорят, тот, кто поднимется на её вершину, исчезнет навсегда.")
	_add("intro_7", "Но однажды двое детей нарушили запрет...")

	# --- Персонажи ---
	_add("glim_1", "* Спереди тебя освещает маленький светлячок по имени ГЛИМ.")
	_add("glim_2", "Глим: «Ого! Живой человек! Мы думали, вы все давно сбежали через Трещину!»")
	_add("glim_3", "Глим: «Тут опасно. Я провожу тебя до Грибной Деревни. Держись рядом!»")
	_add("ember_1", "Эмбер: «Ещё один сверху? Знаешь, как пахнет твоя одежда? Как ПОПАЛ.»")
	_add("ember_2", "Эмбер: «Моя сестра ушла к людям и не вернулась. Все «сверху» — воры.»")
	_add("cog_1", "КОГ-7 тихо жужжит. На его корпусе царапина: «Для АС».")
	_add("cog_2", "КОГ-7: «Бип. Запрос: ремонт. Предложение: обнять меня. Бип.»")
	_add("echo_1", "ЭХО — полупрозрачный олень из тумана. Он смотрит сквозь тебя.")
	_add("echo_2", "ЭХО (мысленно): «Ты слышишь песню ниже печати? Это плачет наш король.»")
	_add("thorn_1", "Терн — страж Лесных Залов. Его корни держат крышу пещеры.")
	_add("thorn_2", "Терн: «Если ты пройдёшь этот лес, я должен буду сразиться с тобой. Прости.»")
	_add("lumen_1", "ЛУМЕН — хранительница Светящегося Озера. Её голос — как звон стекла.")
	_add("lumen_2", "Лумен: «Три испытания. Три осколка памяти. Тогда ты узнаешь правду.»")
	_add("hollow_1", "ХОЛОДНЫЙ КОРОЛЬ сидит на троне из застывших слёз.")
	_add("hollow_2", "Король: «Я запечатал свой народ, чтобы СПАСТИ их от людей. А они возненавидели меня.»")
	_add("hollow_3", "Король: «Отдай мне своё свечение. И я открою тебе выход.»")
	_add("guardian_1", "Хранитель Печати — гигантский механизм предков. Он считает твои грехи.")
	_add("wren_1", "ВРЕН — торговец. «Дёшево! Сердечно! Ну, почти.»")
	_add("mira_1", "МИРА — девочка-монстр из деревни. Рисует солнце мелом на камне.")
	_add("old_root_1", "СТАРЫЙ КОРЕНЬ — древний гриб. Он помнит времена до Печати.")

	# --- Системные сообщения ---
	_add("battle_start_peaceful", "* В воздухе пахнет спорами и надеждой.")
	_add("battle_start_hostile", "* Глаза врага вспыхнули боевым огнём!")
	_add("spare_all", "* Ты пощажен(а)... То есть ПОЩАДИЛ(А) всех. Приятное тепло разливается по душе.")
	_add("flee_ok", "* Ты сбежал(а) из боя. Никто не осудит. Наверное.")
	_add("level_up", "* УРОВЕНЬ ПОВЫСИЛСЯ! Ты чувствуешь себя чуть сильнее. Слишком?)")
	_add("mercy_low", "* Враг ещё не готов к миру. Попробуй другие действия.")
	_add("check_glim", "* GLOM   ATK 2  DEF 0\n* Маленький, но очень храбрый светлячок.")
	_add("save_point", "* Игра сохранена. Ты ощущаешь прилив решимости.")
	_add("tp", "* ТЕЛЕПОРТАЦИЯ. Мир мигнул, и ты уже в другой точке.")
	_add("empty_room", "* Пустая комната. Даже эхо ленится отвечать.")
	_add("dark_room", "* Здесь темно. Твоя душа слабо светится — этого достаточно.")

	# --- Концовки ---
	_add("ending_pacifist_1", "Ты поднимаешься к поверхности вместе с новыми друзьями.")
	_add("ending_pacifist_2", "Солнце впервые за века касается чужих щёк.")
	_add("ending_pacifist_3", "Люди и монстры учатся заново произносить слово «сосед».")
	_add("ending_pacifist_4", "LowerTale: ИСТИННАЯ КОНЦОВКА. Спасибо, что выбрал доброту.")
	_add("ending_neutral_1", "Барьер открылся лишь наполовину. Кто-то остался внизу.")
	_add("ending_neutral_2", "Ты уходишь, зная, что историю можно было написать иначе.")
	_add("ending_neutral_3", "LowerTale: НЕЙТРАЛЬНАЯ КОНЦОВКА.")
	_add("ending_genocide_1", "Гора пуста. Даже пыль боится шевелиться.")
	_add("ending_genocide_2", "Твоя душа тяжелее, чем весь подземный мир.")
	_add("ending_genocide_3", "LowerTale: ТЁМНАЯ КОНЦОВКА.")
	_add("gameover_1", "Не сдавайся!")
	_add("gameover_2", "Твоя решимость горит ярче.")
	_add("gameover_3", "Осталось только улыбаться...")

	# --- Подсказки в мире ---
	_add("hint_arrows", "* Стрелки на полу указывают путь. Подземелья любят подсказки.")
	_add("hint_save", "* Светящийся цветок — точка сохранения. Нажми Z/Z, чтобы сохранить игру.")
	_add("hint_pet", "* Поглаживай существ — это открывает двери лучше ключей.")
	_add("hint_act", "* В бою используй ACT (ДЕЙСТВОВАТЬ), чтобы найти мирное решение.")
